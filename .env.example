# ---------------------------------------------------------------------------
# moin-portfolio — environment template  (PRD 31.2)
#
# Copy to .env.local and fill in. NEVER commit .env / .env.local.
#
# Only VITE_-prefixed variables reach the browser bundle. Anything secret must
# never carry that prefix — a VITE_ secret is compiled into the client and is
# therefore public. See SEC-01.
# ---------------------------------------------------------------------------

# Supabase project URL. Public by nature.
# Local stack default: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Supabase publishable (anon) key. Public by nature; safe ONLY because RLS is
# correct. Printed by `supabase start` for the local stack.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical site origin, no trailing slash. Used for canonical URLs, sitemap
# and Open Graph absolute paths (SEO-05, SEO-06).
# [REQUIRES USER INPUT — Q-11: final domain]
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# NOT USED BY THE FRONTEND — listed so nobody adds them with a VITE_ prefix.
#
#   SUPABASE_SERVICE_ROLE_KEY   Never in this project's frontend. CLI shell or
#                               an Edge Function secret only.
#   SUPABASE_DB_PASSWORD        Developer machine only, for CLI operations.
# ---------------------------------------------------------------------------
